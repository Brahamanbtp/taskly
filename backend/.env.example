# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/taskly

# Redis (For Socket.io Scaling & BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your_super_secret_jwt_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AWS S3 (For Attachments)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET_NAME=taskly-attachments
# Optional: AWS_ENDPOINT for MinIO/Localstack

# Razorpay (For Billing - India Friendly)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PRO_PLAN_AMOUNT=1900 # in paise (INR 19.00)
RAZORPAY_ENT_PLAN_AMOUNT=9900 # in paise (INR 99.00)

# Frontend URL (For Stripe Redirects)
FRONTEND_URL=http://localhost:5173
PORT=4000